{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply",
    "build",
    "terrain",
    "game",
    "portal"
  ],
  "properties": {
    "reply": {
      "type": "string",
      "description": "One or two friendly sentences to the player about what you made or why you could not."
    },
    "build": {
      "description": "The object to create, or null when only replying.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/build"
        }
      ]
    },
    "terrain": {
      "description": "Terrain changes for the selected area, or null when no area is selected or nothing should change.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/terrain"
        }
      ]
    },
    "game": {
      "description": "Game rules for the world (definitions and scripts), or null when the player isn't asking for gameplay.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/game"
        }
      ]
    },
    "portal": {
      "description": "When the player asks for a portal (a gate, door or arch to another world): the world's name from the list you were given, or a server's host:port. The build (or the selected one) becomes a portal there. Null otherwise.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "palette",
        "shapes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Short name, e.g. \"Stone well\"."
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "[x, y, z] build volume in voxels, each between 1 and 64. +Y is up."
        },
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "description": "Applied in order; later shapes overwrite earlier ones."
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hex",
        "material"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "hex": {
          "type": "string",
          "description": "#rrggbb"
        },
        "material": {
          "type": "string",
          "enum": [
            "matte",
            "glossy",
            "metal",
            "glass",
            "glow"
          ]
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "color",
        "from",
        "to",
        "radius",
        "wobble"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "box",
            "ellipsoid",
            "cylinder",
            "capsule"
          ]
        },
        "color": {
          "type": "string",
          "description": "A palette name, or \"air\" to carve."
        },
        "from": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "[x, y, z]"
        },
        "to": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "[x, y, z]"
        },
        "radius": {
          "description": "Capsule radius in voxels; null for other kinds.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "wobble": {
          "description": "0 to 0.4: noisy, organic edges (foliage, rocks). null or 0 for clean shapes.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ops"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Short name, e.g. \"Lily pond\"."
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terrain_op"
          },
          "description": "Applied in order."
        }
      }
    },
    "terrain_op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "area",
        "points",
        "amount_m",
        "level_m",
        "depth_m",
        "width_m",
        "edge_m",
        "material",
        "item",
        "density"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "raise",
            "lower",
            "flatten",
            "smooth",
            "terrace",
            "water",
            "paint",
            "scatter",
            "path",
            "clear"
          ]
        },
        "area": {
          "description": "Where it applies, in meters in the area frame; null for the whole selected area.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/op_area"
            }
          ]
        },
        "points": {
          "description": "path only: [x, z] points in meters.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "amount_m": {
          "description": "raise/lower: meters; terrace: step height.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "level_m": {
          "description": "flatten/water: level in meters relative to sea level; null picks one.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth_m": {
          "description": "water: depth below the level.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "width_m": {
          "description": "path: width.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "edge_m": {
          "description": "Soft edge: the change fades in over this many meters from the shape's border.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "description": "paint/path: ground material.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "grass",
                "dirt",
                "stone",
                "sand",
                "snow"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "description": "scatter/clear: what to add or remove.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "tree",
                "bush",
                "rock",
                "flowers",
                "grass",
                "plants"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "density": {
          "description": "0..1: scatter amount, paint coverage, smooth strength.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "op_area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "x",
        "z",
        "w",
        "d"
      ],
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "ellipse"
          ]
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "d": {
          "type": "number"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "defs",
        "scripts",
        "models"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The package's id, also the prefix of everything in it: 2-32 lowercase letters, digits or _, e.g. \"farm\". Reuse the installed package's name to change it."
        },
        "title": {
          "type": "string",
          "description": "What players see, e.g. \"Turnip farm\"."
        },
        "defs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_def"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_script"
          },
          "description": "Luau scripts with the game's rules (empty for data-only packages)."
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_model"
          },
          "description": "The voxel models the game's pieces look like, in the same format as \"build\"."
        }
      }
    },
    "game_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "title",
        "seed",
        "stage_days",
        "harvest",
        "gives",
        "every_days"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Lowercase id within the package, e.g. \"turnip_seed\"."
        },
        "kind": {
          "type": "string",
          "enum": [
            "item",
            "crop",
            "source",
            "fixture"
          ]
        },
        "title": {
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "crop: the item (by name) that plants it."
        },
        "stage_days": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          ],
          "description": "crop: days each growth stage takes."
        },
        "harvest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stack"
            }
          ],
          "description": "crop: what harvesting it gives."
        },
        "gives": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stack"
            }
          ],
          "description": "source: what it gives a player each time."
        },
        "every_days": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ],
          "description": "source: days between gifts to the same player (null: 1)."
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "count"
      ],
      "properties": {
        "item": {
          "type": "string",
          "description": "An item's name in this package."
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "game_script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "File name ending in .luau, e.g. \"main.luau\"."
        },
        "source": {
          "type": "string",
          "description": "Luau source defining handlers like on_place and on_key."
        }
      }
    },
    "game_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "build"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Lowercase local name, e.g. \"crate\"; pieces show it with look = {model = \"crate\"}."
        },
        "build": {
          "$ref": "#/$defs/build"
        }
      }
    }
  }
}
