{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply",
    "build",
    "terrain",
    "game",
    "portal",
    "describe"
  ],
  "properties": {
    "reply": {
      "type": "string",
      "description": "One or two friendly sentences to the player about what you made or why you could not."
    },
    "build": {
      "description": "The object to create, or null when only replying.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/build"
        }
      ]
    },
    "terrain": {
      "description": "Terrain changes for the selected area, or null when no area is selected or nothing should change.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/terrain"
        }
      ]
    },
    "game": {
      "description": "Game rules for the world (definitions and scripts), or null when the player isn't asking for gameplay.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/game"
        }
      ]
    },
    "portal": {
      "description": "When the player asks for a portal (a gate, door or arch to another world): the world's name from the list you were given, or a server's host:port. The build (or the selected one) becomes a portal there. Null otherwise.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "describe": {
      "description": "What things in the world mean, for later requests to find and understand them: the game files you added or changed (\"feature:world/wolves.luau\"), the package (\"package:world\"), a build or land change by id (\"build:12\", \"land:40\"), or an area the player named or that you made (\"place:Wolf field\", with its area). Null when there's nothing to describe.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "of",
              "name",
              "about",
              "area"
            ],
            "properties": {
              "of": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "about": {
                "type": "string",
                "description": "One line on what it is and what it's for. Empty forgets it."
              },
              "area": {
                "description": "For a place: its middle and size across the ground, meters [x, z, w, d]. Null otherwise.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "palette",
        "shapes",
        "about"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Short name, e.g. \"Stone well\"."
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "[x, y, z] build volume in voxels, each between 1 and 64. +Y is up."
        },
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          },
          "description": "Applied in order; later shapes overwrite earlier ones."
        },
        "about": {
          "description": "One line on what it is and what it's for, so later requests understand the world (\"the camp's well, where the baker draws water\"). Null for a plain model.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "hex",
        "material",
        "roughness",
        "metallic",
        "glow",
        "alpha"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "hex": {
          "type": "string",
          "description": "#rrggbb"
        },
        "material": {
          "type": "string",
          "enum": [
            "matte",
            "glossy",
            "metal",
            "glass",
            "glow"
          ],
          "description": "How it takes the light. The numbers after it change it; null leaves each as the material's."
        },
        "roughness": {
          "description": "0 a mirror to 1 chalk; null for the material's.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "metallic": {
          "description": "0 to 1; null for the material's.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "glow": {
          "description": "Light it gives off in its color, 0 to 1: 0.1 glows and keeps its color, 0.3 pale and hot, 1 a white-hot lantern; null for the material's.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "alpha": {
          "description": "1 solid, down to 0.1 see-through; null for the material's.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "color",
        "from",
        "to",
        "radius",
        "wobble"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "box",
            "ellipsoid",
            "cylinder",
            "capsule"
          ]
        },
        "color": {
          "type": "string",
          "description": "A palette name, or \"air\" to carve."
        },
        "from": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "[x, y, z]"
        },
        "to": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "[x, y, z]"
        },
        "radius": {
          "description": "Capsule radius in voxels; null for other kinds.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "wobble": {
          "description": "0 to 0.4: noisy, organic edges (foliage, rocks). null or 0 for clean shapes.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ops",
        "about"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Short name, e.g. \"Lily pond\"."
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terrain_op"
          },
          "description": "Applied in order."
        },
        "about": {
          "description": "One line on what it is and what it's for, so later requests understand the world (\"the camp's well, where the baker draws water\"). Null for a plain model.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "terrain_op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "area",
        "points",
        "amount_m",
        "level_m",
        "depth_m",
        "width_m",
        "edge_m",
        "material",
        "item",
        "density"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "raise",
            "lower",
            "flatten",
            "smooth",
            "terrace",
            "water",
            "paint",
            "scatter",
            "path",
            "clear"
          ]
        },
        "area": {
          "description": "Where it applies, in meters in the area frame; null for the whole selected area.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/op_area"
            }
          ]
        },
        "points": {
          "description": "path only: [x, z] points in meters.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "amount_m": {
          "description": "raise/lower: meters; terrace: step height.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "level_m": {
          "description": "flatten/water: level in meters relative to sea level; null picks one.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth_m": {
          "description": "water: depth below the level.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "width_m": {
          "description": "path: width.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "edge_m": {
          "description": "Soft edge: the change fades in over this many meters from the shape's border.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "description": "paint/path: what the ground becomes: grass, dirt, stone, sand, snow, or one of this world's own blocks (BLOCKS.md).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "item": {
          "description": "scatter/clear: what to add or remove.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "tree",
                "bush",
                "rock",
                "flowers",
                "grass",
                "plants"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "density": {
          "description": "0..1: scatter amount, paint coverage, smooth strength.",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "op_area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "x",
        "z",
        "w",
        "d"
      ],
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "rect",
            "ellipse"
          ]
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "d": {
          "type": "number"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "defs",
        "scripts",
        "models",
        "shaders",
        "remove",
        "rename"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The world's game package (from the request; reuse it so your change adds to it). Only for a world without one: 2-32 lowercase letters, digits or _, e.g. \"world\"."
        },
        "title": {
          "type": "string",
          "description": "What players see, e.g. \"Wolf Valley\" (empty keeps the current title)."
        },
        "defs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_def"
          },
          "description": "Definitions to add or replace (by name); [] for none."
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_script"
          },
          "description": "Script files to add or replace (by file name), each a feature with its own handlers; [] for none."
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_model"
          },
          "description": "Models to add or replace (by name), in the same format as \"build\"; [] for none."
        },
        "shaders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_shader"
          },
          "description": "WGSL shaders to add or replace (by name), drawn under pieces with a \"decal\" (docs/game.md); [] for none."
        },
        "remove": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Names of defs, script files, models or shaders to take out (a removed script file's pieces go with it); null for none."
        },
        "rename": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  }
                }
              }
            }
          ],
          "description": "Script files to rename ({from, to}): their pieces and timers follow (send the file under its new name only if it changes too); null for none."
        }
      },
      "description": "A change to the world's game logic: what you send replaces what's there by name (defs, script files, models), names in \"remove\" are taken out, and everything else stays."
    },
    "game_shader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Lowercase id within the package, e.g. \"halo\"."
        },
        "source": {
          "type": "string",
          "description": "WGSL defining fn decal(d: Decal) -> vec4<f32> (docs/game.md)."
        }
      }
    },
    "game_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "title",
        "model",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Lowercase id within the package, e.g. \"torch\"."
        },
        "kind": {
          "type": "string",
          "enum": [
            "item",
            "action"
          ],
          "description": "item: something players carry (scripts give and take it). action: something a player does with a key they can change; player scripts see it as f.acted.<name>."
        },
        "title": {
          "type": "string",
          "description": "What players see, e.g. \"Torch\"."
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "One of the package's models: the item's icon in the inventory and in the hand (null: a plain tile)."
        },
        "key": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "action: the key it starts on, by name (\"q\", \"f6\", \"mouse_middle\"); null for items, or to leave it unbound."
        }
      }
    },
    "game_script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "File name ending in .luau, e.g. \"main.luau\"."
        },
        "source": {
          "type": "string",
          "description": "Luau source defining handlers like on_place and on_key."
        }
      }
    },
    "game_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "build"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Lowercase local name, e.g. \"crate\"; pieces show it with look = {model = \"crate\"}."
        },
        "build": {
          "$ref": "#/$defs/build"
        }
      }
    }
  }
}
